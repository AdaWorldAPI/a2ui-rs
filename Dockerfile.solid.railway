# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# a2ui-rs — Railway image for the SOLID tier.
#
# The SECOND deployable, and deliberately separate from `Dockerfile.railway`.
# That one renders the PAINT tier and should keep doing exactly that; mixing a
# CAD demo into it would leave neither claim legible. One image per tier, one
# claim per image.
#
#   Dockerfile.railway        -> a2ui-paint-web   (the paint tier: skins, hit-test)
#   Dockerfile.solid.railway  -> a2ui-solid-web   (this: parametric solids)
#
# WHAT THIS TIER DEMONSTRATES. The a2ui thesis one dimension up: don't push
# meshes — address the solid. A part is a classid plus six `u8:u8` rails on the
# 12-byte content-blind facet; the mesh is DERIVED. `/delta.bin` is the whole
# part on the wire, `/model.stl` is the same part as geometry, and the ratio
# between them is printed at `/health`. Refine with `?res=` and the STL grows
# while the frame does not move — that independence is the claim.
#
# WHY IT IS STILL A LEAN IMAGE. `a2ui-solid` has **zero dependencies**: the CSG
# is a signed-distance field (booleans are `min`/`max`, so mesh-boolean
# robustness never arises), surface extraction is marching tetrahedra
# (watertight by construction), and the binary STL writer is ~40 lines. The
# only crates in the tree are `a2ui-core` for the frames plus axum/tokio —
# the same shape as the paint image. `csgrs`, the obvious geometry dependency,
# is currently unbuildable anyway (it requires the yanked `core2 0.4.0`).
#
# WHY NO GPU. Same as the paint image, and more pointedly: the projection at
# `/` is orthographic isometric computed on the CPU and emitted as SVG
# polygons. Vector out, no raster, no canvas, no `wgpu`. Railway containers
# have no GPU and this tier does not want one.
#
# TOOLCHAIN — 1.98.1 by ALIGNMENT, not necessity, exactly as in the paint
# image. The crates declare `rust-version = "1.95"` and build green there; the
# pin matches the toolchain CLAUDE.md documents so one version holds across the
# workspace. Do not cite this line as evidence that something requires 1.98.1.
# ---------------------------------------------------------------------------

# BASE-IMAGE TAG vs TOOLCHAIN PIN — they are two different things, and only
# one of them has to exist on Docker Hub.
#
# This file previously read `ARG RUST_VERSION=1.98.1` and used it BOTH as the
# toolchain version and as the base-image tag. That build fails outright:
#
#     failed to solve: docker.io/library/rust:1.98.1-slim-bookworm: not found
#
# Measured against the registry: `rust:1.98.1-slim-bookworm` is a 404, while
# `rust:1.98-slim-bookworm` and `rust:1.98.0-slim-bookworm` are both 200 — and
# `https://static.rust-lang.org/dist/channel-rust-1.98.1.toml` is a 200 too.
# So 1.98.1 IS a real Rust release; what does not exist is a docker-library
# IMAGE for that patch. The official-images repo does not tag every point
# release and lags the ones it does. A toolchain pin can therefore be valid
# while its same-numbered image tag is absent, and a Dockerfile that conflates
# them inherits an availability constraint it never meant to take on.
#
# (The failure surfaces confusingly: BuildKit resolves every stage's base in
# parallel, so the last line printed is often the HEALTHY one —
# `load metadata for docker.io/library/debian:bookworm-slim`, which resolves
# fine. Read the `failed to solve:` line, not the last `load metadata` line.)
#
# The fix separates the two concerns:
#   * the base image floats on the MINOR tag, which docker-library always
#     publishes;
#   * the exact toolchain comes from `rust-toolchain.toml`, which rustup
#     honours automatically and which is already this repo's single source of
#     truth for the pin.
#
# That also closes a real gap this file had independently of the 404:
# `rust-toolchain.toml` was NEVER COPIED into the builder, so the image's
# toolchain was whatever the base tag shipped and the pin file had no effect
# here at all — precisely the cross-file drift that file was added to end.
# Copying it before the sources also means a pin bump invalidates the
# toolchain layer and nothing below it.
#
# Consequence worth stating: bumping the pin is now a ONE-line edit in
# `rust-toolchain.toml`. Touch `RUST_IMAGE_TAG` only when the MINOR moves
# (1.98 -> 1.99), and never to a patch-level tag — that is the shape that
# broke.

ARG RUST_IMAGE_TAG=1.98-slim-bookworm
ARG BIN_NAME=a2ui-solid-web

# ── builder ────────────────────────────────────────────────────────────────
FROM rust:${RUST_IMAGE_TAG} AS builder
ARG BIN_NAME

# git for the OGAR / lance-graph git dependencies pulled by sibling crates in
# the workspace. Both repos are PUBLIC — do not add a token to this image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates pkg-config \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# The pin file FIRST, on its own layer: rustup reads it and materialises the
# exact channel + components, so the toolchain in this image is the one the
# repo declares rather than whatever the base tag happens to ship.
COPY rust-toolchain.toml ./
RUN rustup show

COPY Cargo.toml ./
COPY crates ./crates

# NO `Cargo.lock`, NO `--locked` — the deps FLOAT here, on purpose.
#
# Every dependency that matters is a git branch coordinate: ndarray on
# `master`, OGAR on `main`, wgpu on `trunk`. This image resolves them fresh on
# every build, so a push to any of those siblings reaches the next deploy
# without a lock bump, a rev edit, or a commit in this repo. That is the
# intended development property, not a concession.
#
# `--locked` is the exact opposite instruction — it forbids re-resolution — so
# it can never be reinstated while floating is wanted. It also could not have
# worked even if it were: `.cargo/config.toml` is tracked and patches ndarray to
# `path = "../ndarray"`, so a lock committed from a dev checkout records ndarray
# with NO `source` at all, and this image (which deliberately does not copy that
# file) must resolve the same coordinate from git. Different source, same
# package; `--locked` fails on that every build, and the `../ndarray` path does
# not exist in here either.
#
# The lock is not copied for the same reason. Copying it would pin the git revs
# it happens to hold, re-freezing what the branch coordinates exist to keep
# moving — and once the lock is untracked, naming it in a `COPY` is a missing
# build-context source, which fails the build outright.
#
# If a specific deploy ever needs to be reproducible, pin it where a reader can
# see it — an explicit `rev = "..."` on the dependency — not by reintroducing a
# lock whose contents nobody reviews.
RUN cargo build --release -p ${BIN_NAME} \
 && cp target/release/${BIN_NAME} /usr/local/bin/a2ui-solid-web

# ── runtime ────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 a2ui

COPY --from=builder /usr/local/bin/a2ui-solid-web /usr/local/bin/a2ui-solid-web

USER a2ui
WORKDIR /app

# Documentation only. Railway routes to whatever the process binds; EXPOSE
# publishes nothing by itself and is NOT the port contract.
EXPOSE 8080

# No CMD-level port. The binary reads PORT from the environment so Railway's
# injected value wins; baking one in is how a container ends up listening where
# nothing is routed.
CMD ["a2ui-solid-web"]
