# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# a2ui-rs — Railway image for the PAINT tier as an INSTALLABLE APP (PWA).
#
# The third deployable, optional and separate:
#
#   Dockerfile.railway        -> a2ui-paint-web            (the paint tier)
#   Dockerfile.solid.railway  -> a2ui-solid-web            (parametric solids)
#   Dockerfile.pwa.railway    -> a2ui-paint-web --features pwa   (this file)
#
# It builds the SAME binary as `Dockerfile.railway` with the `pwa` cargo
# feature on. The feature adds `/manifest.webmanifest`, `/sw.js` and
# `/icons/*`, links the manifest from the index page and registers a service
# worker that caches the shell only. Every route of the default image behaves
# as before; the existing images and their Railway services are untouched.
#
# This is slice P2 of `docs/MORPHEUS-PWA-APPLICATION-DESKTOP.md` (#56), limited
# to this demo's own origin. It does not install, wrap or control any other
# site's app, and the worker never caches the live surface (`/hit`,
# `/delta.bin`, `/html`).
#
# Installing needs HTTPS, which Railway's public domain provides. On a browser
# without install support the site still works as a normal tab.
#
# Everything else matches `Dockerfile.railway`, and that file carries the
# reasoning: the base image floats on the minor tag while `rust-toolchain.toml`
# pins the toolchain; no `Cargo.lock` and no `--locked`, because the git
# dependencies float on their branches; no `wgpu`, because the container has no
# GPU; bind `0.0.0.0:$PORT`, with 8080 only as a local fallback.
# ---------------------------------------------------------------------------

ARG RUST_IMAGE_TAG=1.99.0-slim-bookworm
ARG BIN_NAME=a2ui-paint-web

# ── builder ────────────────────────────────────────────────────────────────
FROM rust:${RUST_IMAGE_TAG} AS builder
ARG BIN_NAME

# git for the OGAR / lance-graph git dependencies. Both repos are PUBLIC — do
# not add a token to this image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates pkg-config curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY rust-toolchain.toml ./
RUN rustup show

COPY Cargo.toml ./
COPY crates ./crates
COPY scripts/build-optics-wasm.sh ./scripts/

RUN cargo build --release -p ${BIN_NAME} --features pwa \
 && cp target/release/${BIN_NAME} /usr/local/bin/a2ui-paint-web

# The optics GPU renderer behind /lab/optics/gl/* (a2ui-optics-gl, raw WebGL2):
# built to wasm here and shipped as plain files, served from OPTICS_GL_PKG.
# Without this step the lab pages load but the GPU path 404s.
#
# The wasm-bindgen CLI must match the wasm-bindgen crate exactly. There is no
# committed lock (see above), so the version is read from the Cargo.lock the
# build above just resolved, and the matching prebuilt CLI is fetched. A
# mismatch is the silent failure build-optics-wasm.sh guards against, and it
# re-checks the version itself. A failure here fails the image.
RUN rustup target add wasm32-unknown-unknown \
 && v=$(awk '/^name = "wasm-bindgen"$/{getline; gsub(/[",]/,""); print $3; exit}' Cargo.lock) \
 && test -n "$v" \
 && curl -fsSL "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/${v}/wasm-bindgen-${v}-x86_64-unknown-linux-musl.tar.gz" \
    | tar -xz -C /usr/local/bin --strip-components=1 "wasm-bindgen-${v}-x86_64-unknown-linux-musl/wasm-bindgen" \
 && ./scripts/build-optics-wasm.sh /optics-gl-pkg \
 && test -s /optics-gl-pkg/a2ui_optics_gl_bg.wasm && test -s /optics-gl-pkg/a2ui_optics_gl.js

# ── runtime ────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 a2ui

COPY --from=builder /usr/local/bin/a2ui-paint-web /usr/local/bin/a2ui-paint-web
COPY --from=builder /optics-gl-pkg /app/optics-gl-pkg
ENV OPTICS_GL_PKG=/app/optics-gl-pkg

USER a2ui
WORKDIR /app

# Documentation only; the process binds $PORT.
EXPOSE 8080

CMD ["a2ui-paint-web"]
