# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# a2ui-rs — Railway image for the PAINT tier.
#
#    The bin's ONLY hard contract with Railway: bind `0.0.0.0:$PORT`, reading
#    PORT from the environment. Railway injects it; 8080 is a local fallback
#    only and must never be hardcoded as the bind port.
#
# WHAT THIS IMAGE CONTAINS. `a2ui-paint-web` = the paint tier (`a2ui-paint`) +
# the fieldview client (`a2ui-wasm`) + the W1 frames (`a2ui-core`). The client
# is what lets the deployed demo resolve its surface from a real `NodeDelta`
# instead of a hand-written fixture; it costs a git fetch of lance-graph for
# `lance-graph-contract`.
#
# ⚠ CORRECTION (this file, previous revision) — BOTH its reasons were wrong,
# and together they read as a standing reason never to wire the client in:
#
#   1. "pulls the whole lance-graph dependency tree into this image" — FALSE.
#      `lance-graph-contract` is dependency-free BY EXPLICIT DESIGN; its
#      manifest says it "MUST stay dependency-free even of optional path deps,"
#      because as a workspace member any path dep breaks every cargo invocation
#      in their CI. No lance, no DataFusion, no arrow arrives here.
#
#   2. "raises the toolchain floor [to 1.98.1]" — ALSO FALSE, and the more
#      interesting error. Measured: `cargo +1.95.0 build -p a2ui-paint-web`
#      compiles `lance-graph-contract` from scratch and passes all 8 tests.
#      The 1.98.1 came from lance-graph's `rust-toolchain.toml`, which is THAT
#      REPO'S OWN build pin — cargo does not read a dependency's toolchain file,
#      so it never propagates to a consumer. An MSRV that binds you is
#      `rust-version` in the dependency's manifest, and that crate declares
#      none. Reading a `rust-toolchain.toml` as an inherited floor is the
#      generalizable mistake; it is a statement about their CI, not your build.
#
# `a2ui-server` remains out of scope for a reason that survives both
# corrections: RBAC projection + sealed session transport are a server tier this
# demo does not exercise, and it adds `ogar-encryption` + `ogar-vocab` for
# machinery nothing here calls.
#
# WHY NO GPU FEATURE. `a2ui-paint`'s `wgpu` feature is OFF by default and MUST
# stay off here: Railway containers have no GPU. This costs nothing — the
# crate's own doc states the paint-DATA path (layout + hit-test) is pure and
# testable without it. `layout()` / `layout_with_skin()` → `PaintLayout`
# (`PlacedField` / `PlacedAction` / `Hit`) is the whole surface a server-side
# renderer needs; wgpu only adds the surface draw, which belongs in the
# browser, not in this container. Do NOT add `--features wgpu`.
#
# TOOLCHAIN — 1.98.1 by ALIGNMENT, not by necessity. CLAUDE.md documents
# `cargo +1.98.1` as this workspace's toolchain, so the image uses it and one
# version holds everywhere. What this pin is NOT is a floor: the crate declares
# `rust-version = "1.95"` and genuinely builds and tests green on 1.95.0 with
# every dependency present (measured, see the CORRECTION above). A newer
# toolchain always works, so alignment is free — but do not cite this line as
# evidence that something requires 1.98.1. If the floor ever really does rise,
# it will show up as a `rust-version` bump in a manifest, and THAT is the thing
# to move in lockstep with this pin.
# ---------------------------------------------------------------------------

ARG RUST_VERSION=1.98.1
ARG BIN_NAME=a2ui-paint-web

# ── builder ────────────────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-slim-bookworm AS builder
ARG BIN_NAME

# git: the OGAR / lance-graph dependencies are fetched as git deps by cargo.
# Both repos are PUBLIC, so no credential is needed here — do not add a token
# to this image. (Contrast tesseract-rs, whose siblings are path deps cloned
# at build time; this workspace uses git deps and needs no such step.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates pkg-config \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy the manifest first so the dependency build layer caches independently of
# source edits. The lock is deliberately NOT copied — see the note above the
# build step.
COPY Cargo.toml ./
COPY crates ./crates

# NO `Cargo.lock`, NO `--locked` — the deps FLOAT here, on purpose.
#
# Every dependency that matters is a git branch coordinate: ndarray on
# `master`, OGAR on `main`, wgpu on `trunk`. This image resolves them fresh on
# every build, so a push to any of those siblings reaches the next deploy
# without a lock bump, a rev edit, or a commit in this repo. That is the
# intended development property, not a concession.
#
# `--locked` is the exact opposite instruction — it forbids re-resolution — so
# it can never be reinstated while floating is wanted. It also could not have
# worked even if it were: `.cargo/config.toml` is tracked and patches ndarray to
# `path = "../ndarray"`, so a lock committed from a dev checkout records ndarray
# with NO `source` at all, and this image (which deliberately does not copy that
# file) must resolve the same coordinate from git. Different source, same
# package; `--locked` fails on that every build, and the `../ndarray` path does
# not exist in here either.
#
# The lock is not copied for the same reason. Copying it would pin the git revs
# it happens to hold, re-freezing what the branch coordinates exist to keep
# moving — and once the lock is untracked, naming it in a `COPY` is a missing
# build-context source, which fails the build outright.
#
# If a specific deploy ever needs to be reproducible, pin it where a reader can
# see it — an explicit `rev = "..."` on the dependency — not by reintroducing a
# lock whose contents nobody reviews.
RUN cargo build --release -p ${BIN_NAME} \
 && cp target/release/${BIN_NAME} /usr/local/bin/a2ui-paint-web

# ── runtime ────────────────────────────────────────────────────────────────
# Distro-slim, not distroless: the binary is dynamically linked against glibc
# and needs ca-certificates for any outbound TLS. No Rust toolchain, no source,
# no build cache in the final image.
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 a2ui

COPY --from=builder /usr/local/bin/a2ui-paint-web /usr/local/bin/a2ui-paint-web

# Static assets, if the bin serves any. Harmless when the directory is absent
# — but note Docker COPY fails on a missing source, so keep this commented
# until `crates/a2ui-paint-web/static/` actually exists.
# COPY --from=builder /src/crates/a2ui-paint-web/static /app/static

USER a2ui
WORKDIR /app

# Documentation only. Railway routes to whatever the process binds; EXPOSE
# publishes nothing by itself and is NOT the port contract.
EXPOSE 8080

# No CMD-level port. The binary reads PORT from the environment so that
# Railway's injected value wins; baking one in here is how a container ends up
# listening where nothing is routed.
CMD ["a2ui-paint-web"]
